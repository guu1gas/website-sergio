---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>António Sérgio Koch | Architecture</title>
  </head>
  <body>
    <div class="dev-banner">
      Website Under Development
    </div>

    <header>
      <h1>António Sérgio Koch</h1>
      <nav>
        <a href="/">Projects</a>
        <a href="/about">Office</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main class="grid">
      {projects.map((project) => (
        <a href={`/projects/${project.folder}`} class="project-card">
          <div class="image-container">
            <img 
              src={encodeURI(`${r2BaseUrl}/${project.folder}/${project.coverImage}`)} 
              alt={project.title} 
              loading="lazy"
            />
          </div>
          <h2 class="project-title">{project.title}</h2>
        </a>
      ))}
    </main>
  </body>
</html>