---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getAllProjects } from '../utils/r2';

const projects = await getAllProjects(env.R2);
---

<Layout title="Architect Studio | Works">
  <main>
    {projects.length === 0 ? (
      <div style="padding: 4rem 0; text-align: center; color: #777;">
        <p>No projects found in R2.</p>
      </div>
    ) : (
      <div class="portfolio-grid">
        {projects.map((project) => (
          <a href={`/projects/${project.slug}`} class="project-card">
            <div class="image-container">
              <img src={project.coverImage} alt={project.title} loading="lazy" />
            </div>
            <div class="project-meta">
              <span class="title">{project.title}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</Layout>